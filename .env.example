# Turso / libSQL database (used by the Vercel functions in /api and every script)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Secret key for signing session JWTs (long random string; required on Vercel)
JWT_SECRET=replace-with-a-long-random-secret

# Initial admin login, used by scripts/turso_setup.mjs (and the load test)
ADMIN_EMAIL=admin@nu.edu.eg
ADMIN_INITIAL_PASSWORD=

# Google Drive OAuth for the weekly backup and hygiene report (scripts/backup_to_drive.js).
# Either the whole token JSON ({client_id, client_secret, refresh_token}) ...
GDRIVE_TOKEN_JSON=
# ... or the three values separately:
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# Number of weekly backup zips kept on Drive (older ones go to the Drive trash; 0 = keep all)
BACKUP_RETENTION=12

# Optional passphrase (8+ chars) to encrypt weekly backups with AES-256-GCM (.zip.enc)
BACKUP_ENCRYPTION_KEY=
