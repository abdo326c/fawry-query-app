{
  "name": "fawry-app",
  "version": "1.0.0",
  "description": "Internal web app for NU Finance. It imports Fawry payment exports, matches payments to students, reconciles bank settlement files, and produces the Dynamics 365 (ERP) journal file.",
  "main": "app.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sync:views": "node scripts/sync_react_views.mjs",
    "sync:views:check": "node scripts/sync_react_views.mjs --check",
    "sync:vendor": "node scripts/sync_vendor.mjs",
    "postinstall": "node scripts/sync_vendor.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup": "node scripts/backup_to_drive.js",
    "hygiene": "node scripts/database_hygiene.js",
    "hygiene:fix": "node scripts/database_hygiene.js --fix",
    "fx:update": "node scripts/update_fx_rate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdo326c/fawry-query-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/abdo326c/fawry-query-app/issues"
  },
  "homepage": "https://github.com/abdo326c/fawry-query-app#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "flatpickr": "4.6.13",
    "fuse.js": "7.0.0",
    "jszip": "3.10.1",
    "lucide": "0.294.0",
    "papaparse": "5.4.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tom-select": "2.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.1/xlsx-0.20.1.tgz"
  }
}
